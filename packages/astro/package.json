{
  "name": "@plinto/astro",
  "version": "0.1.0",
  "type": "module",
  "description": "Plinto is an admin UI for Astro MDX sites, bundled into the deployed site itself: git-backed content, a visual block editor, and surgical AI translations driven by vector clocks.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxmart/plinto.git",
    "directory": "packages/astro"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "cms",
    "mdx",
    "puck",
    "isomorphic-git",
    "i18n"
  ],
  "files": [
    "src",
    "!src/**/__tests__",
    "!src/test",
    "!src/**/tmp-*",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./config": "./src/config.ts",
    "./integration": "./src/integration.ts",
    "./middleware": "./src/middleware.ts",
    "./preview": "./src/preview.tsx",
    "./styles/globals.css": "./src/styles/globals.css",
    "./components/PreviewButton.astro": "./src/components/PreviewButton.astro",
    "./lib/ops": "./src/lib/ops/index.ts",
    "./lib/urls": "./src/lib/urls.ts",
    "./lib/hooks/usePages": "./src/lib/hooks/usePages.ts",
    "./lib/hooks/useCollection": "./src/lib/hooks/useCollection.ts",
    "./lib/hooks/server-pages": "./src/lib/hooks/server-pages.ts",
    "./lib/hooks/server-collection": "./src/lib/hooks/server-collection.ts",
    "./routes/admin.astro": "./src/routes/admin.astro",
    "./routes/edit.astro": "./src/routes/edit.astro",
    "./routes/edit-collection.astro": "./src/routes/edit-collection.astro",
    "./routes/preview.astro": "./src/routes/preview.astro",
    "./routes/api/files": "./src/routes/api/files.ts",
    "./routes/api/git": "./src/routes/api/git.ts",
    "./lib/listing/summary": "./src/lib/listing/summary.ts"
  },
  "dependencies": {
    "@plinto/admin": "^0.1.0",
    "@plinto/core": "^0.1.0",
    "@isomorphic-git/lightning-fs": "^4.6.2",
    "@puckeditor/core": "^0.21.1",
    "buffer": "^6.0.3",
    "gray-matter": "^4.0.3",
    "isomorphic-git": "^1.36.1",
    "mime-types": "^2.1.35"
  },
  "peerDependencies": {
    "@astrojs/react": "^5.0.0",
    "astro": "^6.0.0 || ^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/mime-types": "^2.1.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  }
}
