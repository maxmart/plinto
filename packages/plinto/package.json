{
  "name": "plinto",
  "version": "0.1.0",
  "description": "Plinto is an admin UI for Astro MDX sites, bundled into the deployed site itself: git-backed content, a visual block editor, and surgical AI translations driven by vector clocks.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxmart/plinto.git",
    "directory": "packages/plinto"
  },
  "homepage": "https://github.com/maxmart/plinto#readme",
  "keywords": [
    "astro",
    "astro-integration",
    "cms",
    "mdx",
    "puck",
    "isomorphic-git",
    "i18n"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "config.js",
    "config.d.ts",
    "integration.js",
    "integration.d.ts",
    "middleware.js",
    "middleware.d.ts",
    "preview.js",
    "preview.d.ts",
    "lib/ops.js",
    "lib/ops.d.ts",
    "lib/urls.js",
    "lib/urls.d.ts",
    "lib/hooks/usePages.js",
    "lib/hooks/usePages.d.ts",
    "lib/hooks/useCollection.js",
    "lib/hooks/useCollection.d.ts",
    "lib/hooks/server-pages.js",
    "lib/hooks/server-pages.d.ts",
    "lib/hooks/server-collection.js",
    "lib/hooks/server-collection.d.ts",
    "routes/api/files.js",
    "routes/api/files.d.ts",
    "routes/api/git.js",
    "routes/api/git.d.ts",
    "lib/listing/summary.js",
    "lib/listing/summary.d.ts"
  ],
  "exports": {
    "./config": {
      "types": "./config.d.ts",
      "default": "./config.js"
    },
    "./integration": {
      "types": "./integration.d.ts",
      "default": "./integration.js"
    },
    "./middleware": {
      "types": "./middleware.d.ts",
      "default": "./middleware.js"
    },
    "./preview": {
      "types": "./preview.d.ts",
      "default": "./preview.js"
    },
    "./styles/globals.css": "@plinto/astro/styles/globals.css",
    "./components/PreviewButton.astro": "@plinto/astro/components/PreviewButton.astro",
    "./lib/ops": {
      "types": "./lib/ops.d.ts",
      "default": "./lib/ops.js"
    },
    "./lib/urls": {
      "types": "./lib/urls.d.ts",
      "default": "./lib/urls.js"
    },
    "./lib/hooks/usePages": {
      "types": "./lib/hooks/usePages.d.ts",
      "default": "./lib/hooks/usePages.js"
    },
    "./lib/hooks/useCollection": {
      "types": "./lib/hooks/useCollection.d.ts",
      "default": "./lib/hooks/useCollection.js"
    },
    "./lib/hooks/server-pages": {
      "types": "./lib/hooks/server-pages.d.ts",
      "default": "./lib/hooks/server-pages.js"
    },
    "./lib/hooks/server-collection": {
      "types": "./lib/hooks/server-collection.d.ts",
      "default": "./lib/hooks/server-collection.js"
    },
    "./routes/admin.astro": "@plinto/astro/routes/admin.astro",
    "./routes/edit.astro": "@plinto/astro/routes/edit.astro",
    "./routes/edit-collection.astro": "@plinto/astro/routes/edit-collection.astro",
    "./routes/preview.astro": "@plinto/astro/routes/preview.astro",
    "./routes/api/files": {
      "types": "./routes/api/files.d.ts",
      "default": "./routes/api/files.js"
    },
    "./routes/api/git": {
      "types": "./routes/api/git.d.ts",
      "default": "./routes/api/git.js"
    },
    "./lib/listing/summary": {
      "types": "./lib/listing/summary.d.ts",
      "default": "./lib/listing/summary.js"
    }
  },
  "dependencies": {
    "@plinto/astro": "^0.1.0"
  },
  "peerDependencies": {
    "@astrojs/react": "^5.0.0",
    "astro": "^6.0.0 || ^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
